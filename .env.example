# Environment Configuration for Real-Time Collaborative Workspace

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://collab_user:collab_secret@localhost:5434/collab_db?schema=public"
DOCKER_DATABASE_URL="postgresql://collab_user:collab_secret@postgres:5432/collab_db?schema=public"

# Inter-Node Communication (Redis 7.2)
REDIS_URL="redis://localhost:6380"
DOCKER_REDIS_URL="redis://redis:6379"

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_BUCKET="document-snapshots"
MINIO_USE_SSL=false

DOCKER_MINIO_ENDPOINT="minio"
DOCKER_MINIO_PORT=9000

# WebSocket Gateways
PORT_NODE_1=4001
PORT_NODE_2=4002
NGINX_PORT=8080

# Next.js Public Endpoints
NEXT_PUBLIC_WS_URL="ws://localhost:8080/ws"
NEXT_PUBLIC_API_URL="http://localhost:8080/api"
