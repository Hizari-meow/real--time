datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  passwordHash   String?
  name           String
  avatarUrl      String?
  documents      Document[]        @relation("DocumentOwner")
  collaborations Collaborator[]
  historyEntries DocumentHistory[] @relation("HistoryAuthor")
  memberships        Member[]
  refreshTokens      RefreshToken[]
  projectMemberships ProjectMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("users")
}

model Document {
  id             String             @id @default(uuid())
  title          String             @default("Untitled Document")
  ownerId        String
  owner          User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  currentVersion Int                @default(1)
  latestS3Key    String?
  snapshots      DocumentSnapshot[]
  history        DocumentHistory[]
  collaborators  Collaborator[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ownerId])
  @@map("documents")
}

model DocumentSnapshot {
  id             String            @id @default(uuid())
  documentId     String
  document       Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int
  s3Key          String
  byteSize       Int
  checksum       String
  mutationCount  Int               @default(0)
  createdAt      DateTime          @default(now())
  historyEntries DocumentHistory[]

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_snapshots")
}

model DocumentHistory {
  id            String            @id @default(uuid())
  documentId    String
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  authorId      String?
  author        User?             @relation("HistoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  snapshotId    String?
  snapshot      DocumentSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  changeSummary String            @default("Checkpoint snapshot")
  createdAt     DateTime          @default(now())

  @@index([documentId])
  @@index([version])
  @@map("document_history")
}

model Collaborator {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @default(EDITOR)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
  @@map("collaborators")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Task {
  id              String           @id @default(uuid())
  orgId           String           @default("org_main")
  org             Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId        String?
  sprint          Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTaskId    String?
  parentTask      Task?            @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks        Task[]           @relation("SubTasks")
  title           String
  description     String           @default("")
  column          String           @default("todo") // todo, in_progress, review, done, blocked
  priority        String           @default("normal") // urgent, high, normal, low
  storyPoints     Int?             @default(0)
  estimatedMinutes Int?            @default(0)
  position        Float            @default(0)
  assigneeId      String?
  assigneeName    String?
  dueDate         DateTime?
  completedAt     DateTime?
  sourceMessageId String?
  labels          String[]
  checklistJson   String           @default("[]")
  assignees       TaskAssignee[]
  dependencies    TaskDependency[] @relation("TaskDependencies")
  dependents      TaskDependency[] @relation("TaskDependents")
  comments        TaskComment[]
  activities      TaskActivity[]
  timeLogs        TaskTimeLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orgId])
  @@index([projectId])
  @@index([sprintId])
  @@index([column])
  @@index([priority])
  @@index([parentTaskId])
  @@map("tasks")
}

model FileRecord {
  id        String   @id @default(uuid())
  name      String
  s3Key     String   @unique
  byteSize  Int
  mimeType  String
  category  String   @default("other")
  ownerName String   @default("System")
  createdAt DateTime @default(now())

  @@index([category])
  @@map("file_records")
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?
  action    String
  actor     String
  target    String
  ip        String   @default("127.0.0.1")
  status    String   @default("SUCCESS")
  details   String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Organization {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  domain        String?
  plan          String       @default("enterprise")
  twofaRequired Boolean      @default(false)
  members       Member[]
  spaces        Space[]
  channels      Channel[]
  wikiPages     WikiPage[]
  tasks         Task[]
  projects      Project[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("organizations")
}

model Member {
  id             String       @id @default(uuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  email          String
  role           String       @default("member") // owner, admin, member, guest
  status         String       @default("active") // active, suspended
  twofaEnabled   Boolean      @default(false)
  department     String       @default("Chung")
  lastActive     String       @default("Vừa xong")
  guestExpiresAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, email])
  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("members")
}

model Space {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  icon        String?      @default("Folder")
  isDefault   Boolean      @default(false)
  channels    Channel[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("spaces")
}

model Channel {
  id          String        @id @default(uuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name        String
  type        String        @default("public") // public, private, dm, group_dm
  topic       String?
  isArchived  Boolean       @default(false)
  messages    Message[]
  members     ChannelMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orgId])
  @@index([spaceId])
  @@map("channels")
}

model ChannelMember {
  id         String   @id @default(uuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  role       String   @default("member")
  notifLevel String   @default("all")
  isMuted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
  @@map("channel_members")
}

model Message {
  id          String            @id @default(uuid())
  channelId   String
  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Message?          @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]         @relation("MessageReplies")
  seq         Int               @default(autoincrement())
  senderId    String
  senderName  String
  senderColor String?
  senderRole  String?
  content     String
  type        String            @default("text") // text, bot, file, task_created
  reactions   MessageReaction[]
  createdAt   DateTime          @default(now())

  @@index([channelId])
  @@index([parentId])
  @@index([seq])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model WikiPage {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title        String
  areaId       String       @default("general")
  topic        String?
  type         String       @default("SOP") // SOP, Guide, Document, Decision
  owner        String
  status       String       @default("draft") // draft, pending_approval, approved
  lastReviewed String?
  tags         String[]
  summary      String?
  content      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@index([areaId])
  @@map("wiki_pages")
}

model Notification {
  id          String    @id @default(uuid())
  orgId       String    @default("org_main")
  userId      String
  actorId     String?
  type        String    @default("mention") // mention, comment, task, meeting, system
  title       String
  body        String
  senderName  String    @default("Hệ thống")
  senderColor String?   @default("#0068ff")
  targetUrl   String    @default("")
  targetLabel String    @default("")
  targetDocId String?
  isRead      Boolean   @default(false)
  isPriority  Boolean   @default(false)
  readAt      DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([orgId])
  @@index([userId, orgId])
  @@index([userId, isRead])
  @@map("notifications")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  orgId       String?
  payload     String
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)

  @@index([type])
  @@index([processedAt])
  @@map("outbox_events")
}

model Webhook {
  id         String            @id @default(uuid())
  orgId      String?
  url        String
  secret     String
  events     String[]
  active     Boolean           @default(true)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())

  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  statusCode Int
  payload    String
  timestamp  DateTime @default(now())
  status     String   @default("success")

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model Project {
  id          String          @id @default(uuid())
  orgId       String          @default("org_main")
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  spaceId     String?
  space       Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name        String
  key         String          // e.g. "PRJ", "ALPHA"
  description String          @default("")
  status      String          @default("planning") // planning, active, completed, archived
  isArchived  Boolean         @default(false)
  ownerId     String
  members     ProjectMember[]
  tasks       Task[]
  sprints     Sprint[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // admin, member, viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orgId       String    @default("org_main")
  name        String
  goal        String    @default("")
  status      String    @default("planning") // planning, active, completed
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([orgId])
  @@index([status])
  @@map("sprints")
}

model TaskAssignee {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  email       String   @default("")
  avatarColor String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskDependency {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  type        String   @default("finish_to_start") // finish_to_start, start_to_start, finish_to_finish
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model TaskComment {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orgId       String   @default("org_main")
  authorId    String
  authorName  String
  authorColor String?  @default("#3b82f6")
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([orgId])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orgId     String   @default("org_main")
  actorId   String
  actorName String
  action    String   // status_changed, assignee_added, comment_added, priority_changed, etc.
  details   String?  // JSON or descriptive text
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([orgId])
  @@index([createdAt])
  @@map("task_activities")
}

model TaskTimeLog {
  id              String    @id @default(uuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orgId           String    @default("org_main")
  userId          String
  userName        String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  note            String?   @default("")
  createdAt       DateTime  @default(now())

  @@index([taskId])
  @@index([orgId])
  @@index([userId])
  @@map("task_time_logs")
}



